---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Game Boy Composer — Greg O'Brien" description="A procedural music generator writing original chiptune melodies for real Game Boy hardware." current={0}>
<div data-screen-label="Work case study">
<div style="border-top:1px solid var(--edge);margin-top:38px;padding:40px 56px 0">
<a href="/build" style="font-size:12.5px;color:var(--muted);text-decoration:none;transition:color .2s ease" class="h-ink">← All work</a>
</div>
<div style="padding:34px 56px 44px;border-bottom:1px solid var(--rule)">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--muted)">Personal · Generative</div>
<h1 style="margin:18px 0 0;font-family:Newsreader,serif;font-weight:400;font-size:54px;line-height:1.1;letter-spacing:-.02em;max-width:22ch">Game Boy Composer</h1>
<p style="margin:18px 0 0;font-size:16px;line-height:1.65;max-width:46ch;color:var(--body)">A procedural music generator writing original chiptune melodies for real Game Boy hardware.</p>
</div>
<div style="padding:40px 56px 24px"><div style="border:1px solid var(--edge)"><div data-shot="1" style="height:260px;background:var(--stripe);display:flex;align-items:flex-end;padding:20px"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--muted);letter-spacing:.08em">[ PROJECT PHOTO ]</span></div></div></div>
<div style="padding:0 56px 44px;max-width:70ch">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Write-up</div>
<p style="margin:18px 0 0;font-size:15.5px;line-height:1.7;color:var(--body)">The full write-up for this one is still being drafted. For now, the short version above is the whole story — check back soon for how it actually went.</p>
<div style="margin-top:34px;border:1px solid var(--edge);padding:26px;background:var(--surface);max-width:340px">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Detail</div>
<div style="margin-top:16px;display:grid;grid-template-columns:84px 1fr;gap:18px;font-size:14.5px;line-height:1.6;color:var(--body)"><span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted)">Status</span><span>Write-up coming</span></div>
</div>
</div>
<div style="border-top:1px solid var(--rule);padding:40px 56px 14px;display:flex;justify-content:space-between;align-items:baseline">
<span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Next</span>
<a href="/build" style="font-size:12.5px;color:var(--muted);text-decoration:none;transition:color .2s ease" class="h-ink">All work →</a>
</div>
<div style="padding:14px 56px 44px;font-size:14px;line-height:1.55;color:var(--muted)">More write-ups coming as new projects are finished.</div>
</div>
</Layout>
