---
import Layout from './Layout.astro';

interface Props {
  title: string;
  date: string;
  subtitle: string;
  heroSrc?: string;
  heroAlt?: string;
  heroWidth?: number;
  heroHeight?: number;
  nextHref: string;
  nextTitle: string;
  nextDate: string;
  current?: number;
}

const { title, date, subtitle, heroSrc, heroAlt, heroWidth, heroHeight, nextHref, nextTitle, nextDate, current = 2 } = Astro.props;
---
<Layout title={title} description={subtitle} current={current}>
<div data-screen-label="Note">
<div style="border-top:1px solid var(--edge);margin-top:38px">
<div style="max-width:880px;margin:0 auto;padding:40px 56px 0">
<a href="/think" style="font-size:12.5px;color:var(--muted);text-decoration:none;transition:color .2s ease" class="h-ink">← All notes</a>
</div>
</div>
<div style="max-width:880px;margin:0 auto">
<div style="padding:34px 56px 44px;border-bottom:1px solid var(--rule)">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--muted)">{date}</div>
<h1 style="margin:18px 0 0;font-family:Newsreader,serif;font-weight:400;font-size:54px;line-height:1.1;letter-spacing:-.02em;max-width:22ch"><slot name="heading" /></h1>
<p style="margin:18px 0 0;font-size:16px;line-height:1.65;max-width:46ch;color:var(--body)">{subtitle}</p>
</div>
<div style="padding:40px 56px 24px"><div style="border:1px solid var(--edge)">
{heroSrc ? (
<div style="aspect-ratio:16/9;overflow:hidden"><img src={heroSrc} alt={heroAlt} width={heroWidth} height={heroHeight} style="width:100%;height:100%;object-fit:cover;display:block" /></div>
) : (
<div data-shot="1" style="aspect-ratio:16/9;background:var(--stripe);display:flex;align-items:flex-end;padding:20px"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.08em;color:var(--muted)">[ AGENT PHOTO ]</span></div>
)}
</div></div>
<div style="padding:0 56px 44px;max-width:70ch">
<slot />
</div>
<div style="border-top:1px solid var(--rule);padding:40px 56px 14px;display:flex;justify-content:space-between;align-items:baseline">
<span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)">Next note</span>
<a href="/think" style="font-size:12.5px;color:var(--muted);text-decoration:none;transition:color .2s ease" class="h-ink">All notes →</a>
</div>
<div style="padding:14px 56px 44px;max-width:70ch">
<a href={nextHref} style="display:flex;justify-content:space-between;align-items:baseline;gap:20px;padding:22px 0;border-bottom:1px solid var(--ruleSoft);text-decoration:none;color:var(--ink);transition:color .2s ease" class="h-accent"><span style="font-family:Newsreader,serif;font-size:23px;line-height:1.3">{nextTitle}</span><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--muted);white-space:nowrap">{nextDate}</span></a>
</div>
</div>
</div>
</Layout>
